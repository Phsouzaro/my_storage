<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (Android 12+): backup na nuvem e transferência entre aparelhos. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="my_storage.db" />
        <include domain="database" path="my_storage.db-wal" />
        <include domain="database" path="my_storage.db-shm" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="my_storage.db" />
        <include domain="database" path="my_storage.db-wal" />
        <include domain="database" path="my_storage.db-shm" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
